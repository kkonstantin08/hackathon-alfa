# Скопируйте в .env и заполните. .env в git НЕ коммитим.

# mock — без сети и бюджета (по умолчанию); live — модели организаторов
LLM_MODE=mock
# OpenAI-совместимый endpoint организаторов (предположение — проверить в день 1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=60
# 1 — передавать response_format=json_object (если провайдер не поддерживает — 0)
LLM_JSON_MODE=1

# Реальные имена моделей у провайдера
MODEL_GEMMA=gemma-4-26b-a4b
MODEL_QWEN=qwen3.6-35b-a3b
MODEL_GLM=glm-5.3-flash
MODEL_KIMI=kimi-k2.6
MODEL_DEEPSEEK=deepseek-v4.1-flash
MODEL_QWEN_VL=qwen3-vl-30b-a3b-instruct

# Какая модель на каком шаге агента (алиасы из списка выше)
PLAN_MODEL=qwen
DRAFT_MODEL=glm
CHAT_MODEL=qwen

# Бюджет: лимит кейса 500 ₽/день, оставляем запас
DAILY_BUDGET_RUB=450
# Цены, руб. за 1000 токенов [вход, выход] — узнать у организаторов
LLM_PRICES_RUB_PER_1K={}
# Квоты по людям в разработке и кто сейчас вызывает модели
BUDGET_QUOTAS={"A": 50, "B": 150, "C": 250, "D": 50}
LLM_OWNER=shared

DB_PATH=data/app.db
# «Сейчас» для свежести ленты (ISO). Пусто — дата самой свежей новости
NOW=
FEED_TAU_DAYS=14
# on — включить эмбеддинги (когда известна разрешённая модель)
EMBEDDINGS=off
